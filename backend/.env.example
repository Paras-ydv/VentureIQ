# Copy to backend/.env (gitignored) and fill in. Every variable is optional.

# GitHub token for live enrichment (founder profiles, org lookup at registration).
# Without it GitHub allows 60 requests/hour per IP; with it, 5,000/hour.
# Fine-grained token: Repository access = "Public repositories (read-only)",
# no other permissions. Classic token: tick no scopes at all.
VIQ_GITHUB_TOKEN=

# data.gov.in API key (free: sign up at https://www.data.gov.in, then "My Account → API key").
# Needed only for the bulk MCA registry import (scripts/import_mca_registry.py).
# Without it, single-CIN lookups still work through the public sample key.
VIQ_DATA_GOV_IN_KEY=

# Defaults to SQLite at backend/ventureiq.db.
# VIQ_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ventureiq

# Browsers that may call this API. Local dev origins are allowed by default;
# add your deployed frontend when you host one.
# VIQ_CORS_ORIGINS=["https://ventureiq.vercel.app"]
